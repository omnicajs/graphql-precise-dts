{
    "compilerOptions": {
        "baseUrl": "..",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noEmit": true,
        "paths": {
            "@app/graphql/enums": [
                "generated/type-consumption/schema/enums.ts"
            ],
            "@app/graphql/schema": [
                "generated/type-consumption/schema/schema.d.ts"
            ]
        },
        "strict": true,
        "types": []
    },
    "include": [
        "../expected/consumer.ts",
        "../expected/dependencies.d.ts",
        "../generated/type-consumption/**/*.d.ts"
    ]
}
